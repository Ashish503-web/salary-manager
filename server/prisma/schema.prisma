generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

// SQLite has no native enum type, so these are enforced as String columns
// with the allowed values validated at the application layer (zod schemas).
// Allowed values:
//  EmploymentStatus: ACTIVE, TERMINATED
//  Gender: FEMALE, MALE, OTHER
//  SalaryChangeReason: HIRE, PROMOTION, MERIT_INCREASE, MARKET_ADJUSTMENT, DEMOTION

model Employee {
  id               String     @id @default(cuid())
  employeeCode     String     @unique
  firstName        String
  lastName         String
  email            String     @unique
  gender           String
  country          String
  department       String
  jobTitle         String
  level            String
  currency         String
  employmentStatus String     @default("ACTIVE")
  hireDate         DateTime
  terminationDate  DateTime?

  managerId String?
  manager   Employee?  @relation("ManagerReports", fields: [managerId], references: [id])
  reports   Employee[] @relation("ManagerReports")

  salaryRecords SalaryRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([department])
  @@index([country])
  @@index([level])
  @@index([employmentStatus])
  @@index([managerId])
}

model SalaryRecord {
  id            String             @id @default(cuid())
  employeeId    String
  employee      Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount        Float
  currency      String
  effectiveDate DateTime
  reason        String
  createdAt     DateTime @default(now())

  @@index([employeeId, effectiveDate])
}
